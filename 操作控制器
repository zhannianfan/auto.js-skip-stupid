function 控件自动化器(机器人) {
    this.机器人 = 机器人;

    this.启动同名应用 = function (应用名, 等待时间) {
        log(`🔍 尝试启动应用: ${应用名}`);
        if (!app.launchApp(应用名)) {
            log(`❌ 直接启动失败，尝试从桌面启动`);
            home();
            sleep(500);
            let 应用控件 = textContains(应用名).findOnce();
            if (应用控件) {
                log(`✅ 在桌面找到应用，点击启动`);
                应用控件.click();
            } else {
                log(`❌ 在桌面也未找到应用: ${应用名}`);
            }
        } else {
            log(`✅ 应用启动成功: ${应用名}`);
        }
        sleep(等待时间);
    };

    this.启动应用 = function (包名, 应用名, 等待时间) {
        log(`🔍 尝试通过包名启动应用: ${包名} (${应用名})`);
        if (!app.launch(包名)) {
            log(`❌ 通过包名启动失败，尝试从桌面启动`);
            home();
            sleep(500);
            let 应用控件 = textContains(应用名).findOnce();
            if (应用控件) {
                log(`✅ 在桌面找到应用，点击启动`);
                应用控件.click();
            } else {
                log(`❌ 在桌面也未找到应用: ${应用名}`);
            }
        } else {
            log(`✅ 应用启动成功: ${应用名}`);
        }
        sleep(等待时间);
    };

    this.点击中心文本 = function (文本内容) {
        log(`🔍 查找文本控件: ${文本内容}`);
        let 文本控件 = text(文本内容).findOnce();
        if (文本控件) {
            log(`✅ 找到文本控件，点击中心位置`);
            this.机器人.点击中心(文本控件);
        } else {
            log(`❌ 未找到文本控件: ${文本内容}`);
        }
    };
    
    this.点击中心包含文本 = function (文本内容) {
        log(`🔍 查找包含文本的控件: ${文本内容}`);
        let 文本控件 = textContains(文本内容).findOnce();
        if (文本控件) {
            log(`✅ 找到包含文本的控件，点击中心位置`);
            this.机器人.点击中心(文本控件);
        } else {
            log(`❌ 未找到包含文本的控件: ${文本内容}`);
        }
    };

    this.点击中心ID = function (控件ID) {
        log(`🔍 查找ID控件: ${控件ID}`);
        let ID控件 = id(控件ID).findOnce();
        if (ID控件) {
            log(`✅ 找到ID控件，点击中心位置`);
            this.机器人.点击中心(ID控件);
        } else {
            log(`❌ 未找到ID控件: ${控件ID}`);
        }
    };

    this.点击中心类名 = function (类名) {
        log(`🔍 查找类名控件: ${类名}`);
        let 类名控件 = className(类名).findOnce();
        if (类名控件) {
            log(`✅ 找到类名控件，点击中心位置`);
            this.机器人.点击中心(类名控件);
        } else {
            log(`❌ 未找到类名控件: ${类名}`);
        }
    };

    this.点击中心描述 = function (描述内容) {
        log(`🔍 查找描述控件: ${描述内容}`);
        let 描述控件 = desc(描述内容).findOnce();
        if (描述控件) {
            log(`✅ 找到描述控件，点击中心位置`);
            this.机器人.点击中心(描述控件);
        } else {
            log(`❌ 未找到描述控件: ${描述内容}`);
        }
    };

    // -------------------------------
    this.点击文本 = function (文本内容) {
        log(`🔍 直接点击文本: ${文本内容}`);
        let 文本控件 = text(文本内容).findOnce();
        if (文本控件) {
            log(`✅ 点击文本控件`);
            文本控件.click();
        } else {
            log(`❌ 未找到文本控件: ${文本内容}`);
        }
    };

    this.点击ID = function (控件ID) {
        log(`🔍 直接点击ID: ${控件ID}`);
        let ID控件 = id(控件ID).findOnce();
        if (ID控件) {
            log(`✅ 点击ID控件`);
            ID控件.click();
        } else {
            log(`❌ 未找到ID控件: ${控件ID}`);
        }
    };

    this.点击类名 = function (类名) {
        log(`🔍 直接点击类名: ${类名}`);
        let 类名控件 = className(类名).findOnce();
        if (类名控件) {
            log(`✅ 点击类名控件`);
            类名控件.click();
        } else {
            log(`❌ 未找到类名控件: ${类名}`);
        }
    };

    this.点击描述 = function (描述内容) {
        log(`🔍 直接点击描述: ${描述内容}`);
        let 描述控件 = desc(描述内容).findOnce();
        if (描述控件) {
            log(`✅ 点击描述控件`);
            描述控件.click();
        } else {
            log(`❌ 未找到描述控件: ${描述内容}`);
        }
    };
}

module.exports = 控件自动化器;
